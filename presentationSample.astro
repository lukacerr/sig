</section>

<script is:inline>
	const deck = document.querySelector("[data-deck]");
	if (deck) {
		const slides = Array.from(deck.querySelectorAll("[data-slide]"));
		const counter = deck.querySelector("[data-counter]");
		const previousButton = deck.querySelector("[data-prev]");
		const nextButton = deck.querySelector("[data-next]");
		const totalSlides = Number(deck.dataset.totalSlides || slides.length);
		let currentSlide = Number(deck.dataset.initialSlide || 1);
		let touchStartX = 0;

		function slideFromPath() {
			const match = window.location.pathname.match(/\/presentacion\/(\d+)\/?$/);
			if (!match) return currentSlide;
			const next = Number(match[1]);
			return Number.isFinite(next)
				? Math.min(Math.max(next, 1), totalSlides)
				: currentSlide;
		}

		function setSlide(nextSlide, options = {}) {
			const clampedSlide = Math.min(Math.max(nextSlide, 1), totalSlides);
			const direction = clampedSlide >= currentSlide ? "next" : "prev";
			currentSlide = clampedSlide;
			deck.dataset.direction = direction;

			for (const slide of slides) {
				const isActive = Number(slide.dataset.slide) === currentSlide;
				slide.classList.toggle("is-active", isActive);
				slide.setAttribute("aria-hidden", isActive ? "false" : "true");

				const fragments = Array.from(slide.querySelectorAll(".deck-fragment"));
				fragments.forEach((fragment, index) => {
					fragment.style.setProperty("--fragment-delay", `${index * 140}ms`);
					fragment.classList.toggle("is-visible", isActive);
				});
			}

			if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
			previousButton?.toggleAttribute("disabled", currentSlide === 1);
			nextButton?.toggleAttribute("disabled", currentSlide === totalSlides);

			const targetPath =
				currentSlide === 1
					? "/presentacion/1"
					: `/presentacion/${currentSlide}`;
			if (!options.skipHistory && window.location.pathname !== targetPath) {
				window.history.pushState({ slide: currentSlide }, "", targetPath);
			}
		}

		function nextSlide() {
			setSlide(currentSlide + 1);
		}

		function previousSlide() {
			setSlide(currentSlide - 1);
		}

		previousButton?.addEventListener("click", previousSlide);
		nextButton?.addEventListener("click", nextSlide);

		window.addEventListener("keydown", (event) => {
			if (["ArrowRight", " ", "PageDown"].includes(event.key)) {
				event.preventDefault();
				nextSlide();
			}
			if (["ArrowLeft", "PageUp"].includes(event.key)) {
				event.preventDefault();
				previousSlide();
			}
			if (event.key === "Home") setSlide(1);
			if (event.key === "End") setSlide(totalSlides);
		});

		window.addEventListener("popstate", () => {
			setSlide(slideFromPath(), { skipHistory: true });
		});

		deck.addEventListener("touchstart", (event) => {
			touchStartX = event.changedTouches[0]?.clientX || 0;
		});

		deck.addEventListener("touchend", (event) => {
			const touchEndX = event.changedTouches[0]?.clientX || 0;
			const delta = touchEndX - touchStartX;
			if (Math.abs(delta) < 50) return;
			if (delta < 0) nextSlide();
			else previousSlide();
		});

		setSlide(slideFromPath(), { skipHistory: true });
	}
</script>

