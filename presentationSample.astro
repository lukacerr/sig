---
import {
	type PresentationIcon,
	type PresentationVisual,
	presentationSlides,
} from "@/data/presentation";

interface Props {
	initialSlide?: number;
}

const { initialSlide = 1 } = Astro.props;
const safeInitialSlide = Math.min(
	Math.max(Number(initialSlide) || 1, 1),
	presentationSlides.length,
);

const iconPaths: Record<PresentationIcon, string> = {
	spark:
		"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z M5 17l1 2l2 1l-2 1l-1 2l-1-2l-2-1l2-1l1-2z M19 16l.8 1.7l1.7.8l-1.7.8L19 21l-.8-1.7l-1.7-.8l1.7-.8L19 16z",
	users:
		"M9 11a4 4 0 1 0 0-8a4 4 0 0 0 0 8z M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2 M16 3.1a4 4 0 0 1 0 7.8 M21 21v-2a4 4 0 0 0-3-3.85",
	shirt: "M8 4l4 2l4-2l5 4l-3 4v8H6v-8L3 8l5-4z M10 5.2a2 2 0 0 0 4 0",
	drop: "M12 3C8 8 6 11 6 14a6 6 0 0 0 12 0c0-3-2-6-6-11z M9 15a3 3 0 0 0 3 3",
	filter: "M4 5h16l-6 7v5l-4 2v-7L4 5z M8 5v-2h8v2",
	sensor:
		"M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M6.35 6.35a8 8 0 0 0 0 11.3 M17.65 6.35a8 8 0 0 1 0 11.3 M3.5 3.5a12 12 0 0 0 0 17 M20.5 3.5a12 12 0 0 1 0 17",
	phone:
		"M9 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M11 18h2",
	qr: "M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h2v2h-2z M18 14h2v4h-2z M14 18h4v2h-4z",
	gift: "M4 11h16v9H4z M4 11V8h16v3 M12 8v12 M9 8a2.5 2.5 0 1 1 3-3c0 1.7 0 3-3 3z M15 8c-3 0-3-1.3-3-3a2.5 2.5 0 1 1 3 3z",
	map: "M9 18l-6 3V6l6-3l6 3l6-3v15l-6 3l-6-3z M9 3v15 M15 6v15 M17 10m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0",
	chart: "M4 19h16 M7 16v-5 M12 16V8 M17 16v-9 M6 10l4-4l4 3l4-5 M18 4v5h-5",
	history: "M12 8v5l3 2 M5.6 7.1A8 8 0 1 1 4 12 M4 5v4h4",
	material:
		"M7 6c3-2 7-2 10 0 M7 10c3-2 7-2 10 0 M7 14c3-2 7-2 10 0 M6 18c4-2 8-2 12 0 M5 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M19 17m-1 0a1 1 0 1 0 2 0a1 1 0 1 0-2 0",
	building:
		"M4 21h16 M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16 M9 8h1 M14 8h1 M9 12h1 M14 12h1 M9 16h1 M14 16h1",
	shield: "M12 3l7 3v5c0 5-3 8-7 10c-4-2-7-5-7-10V6l7-3z M9 12l2 2l4-5",
	web: "M4 5h16v14H4z M4 9h16 M8 5v4 M8 13h4 M8 16h8 M15 13h1",
	file: "M14 3v5h5 M6 3h8l5 5v13H6z M9 13h6 M9 17h6",
};

function renderIcon(name: PresentationIcon) {
	return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${iconPaths[name]}" /></svg>`;
}

function visualClass(visual?: PresentationVisual) {
	return visual ? `visual-${visual.type}` : "visual-none";
}

const scaleDots = Array.from({ length: 20 }, (_, index) => {
	const angle = (index / 20) * Math.PI * 2;
	return {
		left: `${50 + Math.cos(angle) * 32}%`,
		top: `${50 + Math.sin(angle) * 24}%`,
		delay: `${index * -110}ms`,
	};
});
---

<section
	class="deck-shell"
	data-deck
	data-initial-slide={safeInitialSlide}
	data-total-slides={presentationSlides.length}
>
	<div class="deck-frame" aria-live="polite">
		{
			presentationSlides.map((slide, index) => (
				<article
					class:list={[
						"deck-slide",
						`variant-${slide.variant}`,
						`tone-${slide.tone ?? "blue"}`,
						`animation-${slide.animation}`,
						visualClass(slide.visual),
						{ "is-active": index + 1 === safeInitialSlide },
					]}
					data-slide={index + 1}
					aria-hidden={index + 1 === safeInitialSlide ? "false" : "true"}
				>
					<div class="slide-noise" aria-hidden="true" />
					<header class="slide-header deck-fragment">
						<div>
							<p class="slide-eyebrow">{slide.eyebrow}</p>
							<h1>{slide.title}</h1>
						</div>
						<img src="/fiberloop-logo.png" alt="FiberLoop" class="slide-logo" />
					</header>

					<div class="slide-body">
						<section class="slide-copy">
							{slide.lead && (
								<p class="slide-lead deck-fragment">{slide.lead}</p>
							)}

							{slide.stat && (
								<div class="slide-stat deck-fragment">
									<strong>{slide.stat.value}</strong>
									<span>{slide.stat.label}</span>
								</div>
							)}

							{slide.links && (
								<div class="slide-links deck-fragment">
									{slide.links.map((link) => (
										<a
											href={link.href}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noreferrer" : undefined}
										>
											{link.label}
											<span aria-hidden="true">↗</span>
										</a>
									))}
								</div>
							)}
						</section>

						{slide.visual && (
							<aside class="slide-visual deck-fragment">
								{slide.visual.type === "photo" && (
									<figure class="photo-panel">
										<img
											src={slide.visual.src}
											alt={slide.visual.alt}
											loading="lazy"
										/>
										{slide.visual.caption && (
											<figcaption>{slide.visual.caption}</figcaption>
										)}
									</figure>
								)}

								{slide.visual.type === "device" && (
									<div
										class="device-visual"
										aria-label="Diagrama de lavarropas conectado a un cartucho filtrante"
									>
										<div class="washer" />
										<div class="hose" />
										<div class="cartridge" />
										<div class="pulse" />
									</div>
								)}

								{slide.visual.type === "flow" && (
									<div
										class="flow-visual"
										aria-label="Flujo de filtrado, sensores, app y recolección"
									>
										{(
											["filter", "sensor", "phone", "qr"] as PresentationIcon[]
										).map((icon) => (
											<span class="flow-node" set:html={renderIcon(icon)} />
										))}
									</div>
								)}

								{slide.visual.type === "phone" && (
									<div
										class="phone-visual"
										aria-label="Mock visual de la app FiberLoop"
									>
										<div class="phone-shell">
											<div class="phone-bar" />
											<div class="phone-card">
												<div class="phone-progress" />
											</div>
											<div class="phone-row" />
											<div class="phone-row" />
										</div>
									</div>
								)}

								{slide.visual.type === "scale" && (
									<div
										class="scale-visual"
										aria-label="Acumulación de microfibras por ciclos repetidos"
									>
										<div class="scale-orbits">
											<span />
											<span />
											<span />
										</div>
										<div class="scale-core">
											<strong>microfibras</strong>
											<span>acumuladas</span>
										</div>
										<div class="scale-source source-home">hogares</div>
										<div class="scale-source source-laundry">lavaderos</div>
										<div class="scale-source source-institution">
											instituciones
										</div>
										<div class="scale-thread thread-a" />
										<div class="scale-thread thread-b" />
										<div class="scale-thread thread-c" />
										<div class="scale-dots" aria-hidden="true">
											{scaleDots.map((dot) => (
												<span
													style={`--dot-left: ${dot.left}; --dot-top: ${dot.top}; --dot-delay: ${dot.delay};`}
												/>
											))}
										</div>
									</div>
								)}

								{slide.visual.type === "impact" && (
									<div
										class="impact-visual"
										aria-label="Indicador de impacto de la prueba"
									>
										<div class="impact-meter" />
										<div class="impact-bars">
											<span />
											<span />
											<span />
										</div>
									</div>
								)}

								{slide.visual.type === "risk" && (
									<div
										class="risk-visual"
										aria-label="Anillo de mitigación de riesgos"
									>
										<div class="risk-ring" />
									</div>
								)}

								{slide.visual.type === "demo" && (
									<div
										class="demo-visual"
